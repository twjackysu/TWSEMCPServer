# TWStockMCPServer Environment Variables
# Copy this file to .env and modify as needed

# ===== TWSE API Configuration =====

# TWSE API Base URL
# TWSE_API_BASE_URL=https://openapi.twse.com.tw/v1

# User Agent for API requests
# TWSE_USER_AGENT=stock-mcp/1.0

# Minimum interval between API requests (seconds)
# Lower values may trigger rate limiting
# TWSE_REQUEST_INTERVAL=0.5

# Default timeout for API requests (seconds)
# TWSE_API_TIMEOUT=30.0

# TLS certificate verification (default: true; every upstream host verifies).
# Set to false only behind a TLS-intercepting proxy — it turns verification off for every host.
# TWSE_VERIFY_SSL=true

# TTL (seconds) for the in-memory OpenAPI list-response cache
# Set to 0 to disable caching
# TWSE_CACHE_TTL=60

# Max entries in the fetch_json/fetch_bytes response cache used by MOPS/TDCC/NDC/CBC tools
# TWSE_RESPONSE_CACHE_MAX_ENTRIES=256

# Per-site circuit breaker: after this many failed requests in a row to one site (or one refusal:
# HTTP 403/429, a block page), requests to it fail fast for the cooldown (seconds), which doubles
# each time the next attempt fails again, up to the maximum. 0 disables the breaker.
# TWSE_BREAKER_FAILURES=3
# TWSE_BREAKER_COOLDOWN=30
# TWSE_BREAKER_MAX_COOLDOWN=600

# ===== Tools Served =====

# Serve only some data sources: comma-separated tags from
#   twse, tpex, taifex, mops, tdcc, sitca, ndc, cbc
# A tool is hidden when any source it reads is not served. Empty INCLUDE = every source;
# EXCLUDE is taken off what INCLUDE leaves. An unknown name stops the server.
# TWSE_INCLUDE_SOURCES=twse,tpex
# TWSE_EXCLUDE_SOURCES=taifex

# Last-resort cap on one tool reply (bytes). A longer reply is cut and ends with a notice asking
# for a narrower query. Normal replies are 2-48 KB; 0 turns the cap off.
# TWSE_MAX_RESPONSE_BYTES=500000

# ===== Display Configuration =====

# Default number of records to display in list responses
# DISPLAY_LIMIT=20

# Maximum number of records for holiday schedule
# HOLIDAY_DISPLAY_LIMIT=50

# ===== Testing Configuration =====

# Delay between test requests (seconds)
# Increase this value in CI environments to avoid rate limiting
# PYTEST_DELAY_SECONDS=1.0
