# TWStockMCPServer Environment Variables
# Copy this file to .env and modify as needed

# ===== TWSE API Configuration =====

# TWSE API Base URL
# TWSE_API_BASE_URL=https://openapi.twse.com.tw/v1

# User Agent for API requests
# TWSE_USER_AGENT=stock-mcp/1.0

# Minimum interval between API requests (seconds)
# Lower values may trigger rate limiting
# TWSE_REQUEST_INTERVAL=0.5

# Default timeout for API requests (seconds)
# TWSE_API_TIMEOUT=30.0

# SSL certificate verification
# Set to true to enable SSL verification (may fail with TWSE API)
# TWSE_VERIFY_SSL=false

# TTL (seconds) for the in-memory OpenAPI list-response cache
# Set to 0 to disable caching
# TWSE_CACHE_TTL=60

# Max entries in the fetch_json/fetch_bytes response cache used by MOPS/TDCC/NDC/CBC tools
# TWSE_RESPONSE_CACHE_MAX_ENTRIES=256

# ===== Display Configuration =====

# Default number of records to display in list responses
# DISPLAY_LIMIT=20

# Maximum number of records for holiday schedule
# HOLIDAY_DISPLAY_LIMIT=50

# ===== Testing Configuration =====

# Delay between test requests (seconds)
# Increase this value in CI environments to avoid rate limiting
# PYTEST_DELAY_SECONDS=1.0


# ===== 分點進出資料庫 (Branch trades, PostgreSQL) =====
# 自建的分點進出資料庫（branch_trades_schema.sql），例如 Neon。
# 未設定時 8 支分點工具仍會註冊，但呼叫會回「尚未設定分點資料庫連線」，
# server 不會啟動失敗、CI 也不受影響。

# 查詢用連線字串。建議指向唯讀 role，這樣 MCP server 預設對資料庫是唯讀的。
# BRANCH_DB_URL=postgresql://user:password@host/dbname?sslmode=require

# 僅 backfill_branch_reference_data 使用的可寫入連線字串。
# 未設定時退回 BRANCH_DB_URL。
# BRANCH_DB_WRITE_URL=

# 查詢結果快取秒數。過去交易日的分點資料不會再變動
# BRANCH_DB_CACHE_TTL=300

# 連線／查詢 timeout（秒）。託管資料庫的 compute 冷啟動會讓第一次連線變慢
# BRANCH_DB_TIMEOUT=15

# 單次查詢回傳列數硬上限
# BRANCH_DB_MAX_ROWS=5000
